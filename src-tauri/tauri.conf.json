{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Aurolis",
  "version": "../package.json",
  "identifier": "app.aurolis.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Aurolis",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "visible": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 14,
          "y": 16
        },
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https:",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "deb",
      "appimage"
    ],
    "publisher": "Sagar Sen",
    "homepage": "https://aurolis.dev",
    "copyright": "Copyright 2026 Aurolis contributors",
    "category": "DeveloperTool",
    "shortDescription": "Open-source API client built on git",
    "longDescription": "Aurolis is a local-first desktop API client. Every workspace is a git repository on your computer: send REST, GraphQL, WebSocket and Socket.IO requests, keep secrets in the system keychain, and commit and sync with GitHub or any git host.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": {
        "section": "devel"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJBNzI5OEYxQUU1QTQ4Q0QKUldUTlNGcXU4Wmh5S3QwR29sTmxFRmwrYjhGdU9jZzdodjlibHFMSjUzL0xCcG4wenV3U1ZFY2wK",
      "endpoints": [
        "https://github.com/sagarsen2023/aurolis-api-client/releases/latest/download/latest.json"
      ]
    }
  }
}
