# Client ID of the Aurolis GitHub App (Settings → Developer settings → GitHub Apps).
# It is public and gets built into the app. Device-flow sign-in needs no client
# secret, so never add one to this file or to the code.
VITE_PUBLIC_GITHUB_CLIENT_ID=

# Slug of the same GitHub App, from its URL github.com/apps/<slug>. Public.
# Used to open the install page when the app isn't installed on any repo yet.
VITE_PUBLIC_GITHUB_APP_SLUG=
