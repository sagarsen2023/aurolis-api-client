{
  "name": "aurolis",
  "productName": "Aurolis",
  "description": "Aurolis - an open-source API client.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "homepage": "https://aurolis.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/sagarsen2023/aurolis-api-client.git"
  },
  "author": {
    "name": "Sagar Sen",
    "email": "sagarsen.dev@gmail.com"
  },
  "scripts": {
    "dev": "tauri dev",
    "dev:web": "vite",
    "build": "tsc -b && vite build",
    "error-check": "tsc -b",
    "tauri": "tauri",
    "dist": "tauri build",
    "dist:mac": "tauri build --target universal-apple-darwin",
    "dist:win": "tauri build --target x86_64-pc-windows-msvc",
    "dist:linux": "tauri build --target x86_64-unknown-linux-gnu",
    "release": "bash scripts/release.sh patch",
    "release:minor": "bash scripts/release.sh minor",
    "release:major": "bash scripts/release.sh major",
    "version": "node scripts/sync-cargo-version.mjs && git add src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "lint:rust": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:ox": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-xml": "^6.1.0",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.8",
    "@codemirror/search": "^6.7.3",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.44.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/wix-madefor-display": "^5.3.0",
    "@fontsource/tiro-kannada": "^5.3.0",
    "@lezer/highlight": "^1.2.5",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/router-plugin": "^1.169.0",
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "@uiw/react-codemirror": "^4.25.13",
    "@uiw/react-markdown-preview": "^5.2.1",
    "@uiw/react-md-editor": "^4.2.4",
    "autoprefixer": "^10.7.0",
    "class-variance-authority": "^0.7.1",
    "cm6-graphql": "^1.0.0",
    "cn": "^0.5.2",
    "fflate": "^0.8.3",
    "graphql": "^17.1.0",
    "jotai": "^3.0.2",
    "lucide-react": "^1.79.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-resizable-panels": "^4.24.2",
    "rehype-sanitize": "^6.0.0",
    "shadcn": "^4.23.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/eslint-plugin-query": "^5.108.4",
    "@tanstack/router-devtools": "^1.167.4",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript/native": "npm:typescript@~7.0.2",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitejs/plugin-react-swc": "^4.3.3",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "oxlint": "^1.90.0",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.74.0",
    "vite": "^8.3.6"
  }
}
