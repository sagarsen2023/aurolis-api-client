{
  "name": "aurolis",
  "productName": "Aurolis",
  "description": "Aurolis — an open-source API client.",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
